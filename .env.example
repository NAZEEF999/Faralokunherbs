# ─── Faralokun Vital Herbs — environment template ────────────────────────────
# Copy this file to `.env` locally, or paste the values into your Vercel
# project's Environment Variables. NEVER commit real secrets — `.env` is
# git-ignored; for deployment set the values in Vercel instead.

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,.vercel.app,127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# Security (only taken into account when DEBUG=False). SECURE_HSTS_PRELOAD is
# opt-in — leave as False until your production domain is final.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=False

# ── Database (leave blank to fall back to local SQLite) ──────────────────────
DATABASE_URL=

# ── Cloudinary (media storage) — required for image uploads ──────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=owner@example.com

# ── Web Push (VAPID) — optional; required for dashboard notifications ─────────
# Generate with: python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=owner@example.com

# ── WhatsApp Business Cloud API — optional; required for automatic alerts ─────
WHATSAPP_BUSINESS_API_TOKEN=
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# ── Vercel ────────────────────────────────────────────────────────────────────
# Set to 0 to skip the automatic collectstatic on cold start.
VERCEL_COLLECTSTATIC=1